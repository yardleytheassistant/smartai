# --- LLM endpoint (OpenAI-compatible, local open-source models) ---
# Ollama default. LLM_MODEL is the custom 'novel' agent model built by
# build_model.sh from the open-source qwen3.5:122b base. No cloud APIs / no
# Claude — everything runs locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=novel

# MLX alternative (run an MLX server on :8080 and point LLM_BASE_URL at it):
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=mlx

# --- Model routing (step 4: map the local fleet to roles) ---
# Defaults are chosen from a typical local fleet by each model's strength.
# Override to match what you have pulled.
WORKER_MODEL=qwen3.6:35b          # fan-out / simple work: fast MoE generalist
GRADER_MODEL=deepseek-r1:32b      # independent verifier: fast reasoning distill
REASONER_MODEL=deepseek-r1:70b    # hard-but-bounded reasoning subtasks
CODER_MODEL=qwen3-coder:30b       # coding-shaped tasks
LONG_CONTEXT_MODEL=llama4:scout   # whole-repo / long-document tasks (10M ctx)
HEAVY_MODEL=qwen3:235b            # max-capability planning (heavy; reserve it)
VISION_MODEL=kimi-vl              # vision self-checks (VLM via llama.cpp/ollama)
# Sensitive-domain fallback (blank => REASONER_MODEL).
# FALLBACK_MODEL=deepseek-r1:70b

# --- Safety policy (open-source analog of the Mythos boundary) ---
# How to handle tasks that match a sensitive domain (cyber/bio/chem/distillation):
#   route (default) — send to FALLBACK_MODEL, flagged   review — hold for a human
#   block — refuse                                       allow — no special handling
SAFETY_POLICY=route

# --- Generation ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# Graders run near-deterministic so verdicts are reproducible.
GRADER_TEMPERATURE=0.0

# --- Agent loop ---
AGENT_MAX_STEPS=12
# Allow the agent to run shell commands (0 = disabled, 1 = enabled). Off by default for safety.
AGENT_ENABLE_SHELL=0
# Directory the file/shell tools are sandboxed to.
AGENT_WORKSPACE=./workspace

# --- Self-improvement layer ---
# Max maker->verifier iterations in a goal loop before giving up.
GOAL_MAX_ITERATIONS=4
# Durable memory / state file (relative to the workspace).
AGENT_MEMORY_FILE=STATE.md
# Procedural-memory skills directory (relative to the project root; it's versioned).
AGENT_SKILLS_DIR=skills
# Knowledge base: versioned reference docs the agent can search (retrieval layer).
AGENT_KNOWLEDGE_DIR=knowledge
# Optional embedding model for KB search (blank => deterministic keyword search).
# EMBED_MODEL=nomic-embed-text
# Max recursion depth for sub-agent delegation.
SUBAGENT_MAX_DEPTH=2
# Routines registry (saved configs). Copy routines.example.json to get started.
AGENT_ROUTINES_FILE=routines.json
