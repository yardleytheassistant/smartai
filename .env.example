# --- LLM endpoint (OpenAI-compatible) ---
# Ollama default:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=hermes3:70b

# MLX alternative (run: mlx_lm.server --model mlx-community/Hermes-3-Llama-3.1-70B-4bit --port 8080)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=mlx
# LLM_MODEL=mlx-community/Hermes-3-Llama-3.1-70B-4bit

# --- Generation ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- Agent ---
AGENT_MAX_STEPS=12
# Allow the agent to run shell commands (0 = disabled, 1 = enabled). Off by default for safety.
AGENT_ENABLE_SHELL=0
# Directory the file/shell tools are sandboxed to.
AGENT_WORKSPACE=./workspace

# =====================================================================
#  Polymarket mirror bot  (python -m mirror)
# =====================================================================
# Wallet to copy. Default is the address from the profile URL this bot
# was built for (the "-<digits>" suffix in the URL is just a display id).
MIRROR_TARGET_WALLET=0xf3ce251f9c4ae0f3940a9f32de5dd1a1d05b8bc6

# SAFETY: starts in dry-run — logs orders but places none. Set to 0 to go live.
MIRROR_DRY_RUN=1

# --- Your account (only needed when MIRROR_DRY_RUN=0) ---
# WARNING: this is a hot key that can move funds. Never commit your real .env.
POLY_PRIVATE_KEY=
# Address that holds your USDC / positions (your proxy "funder" address).
POLY_FUNDER=
# 0 = EOA (MetaMask/hardware), 1 = email/Magic proxy wallet, 2 = browser proxy.
POLY_SIGNATURE_TYPE=1
POLY_CHAIN_ID=137
POLY_DATA_API=https://data-api.polymarket.com
POLY_CLOB_HOST=https://clob.polymarket.com

# --- Sizing & risk guards ---
# Multiplier on the target's USDC size. 1.0 = same dollar amount, 0.1 = a tenth.
MIRROR_COPY_RATIO=1.0
# Skip trades whose mirrored size is below this many USDC (dust).
MIRROR_MIN_USDC=1.0
# Hard cap on USDC committed to any single mirrored trade.
MIRROR_MAX_USDC=100.0

# --- Loop & execution ---
MIRROR_POLL_SECONDS=15
# FOK = all-or-nothing immediate fill; FAK = fill what you can, cancel the rest.
MIRROR_ORDER_TYPE=FOK
# On first run, also replay the target's existing history (0 = only new trades).
MIRROR_BACKFILL=0
MIRROR_STATE_FILE=./mirror_state.json
