# --- LLM endpoint (OpenAI-compatible, local open-source models) ---
# Ollama default. LLM_MODEL is the custom 'novel' agent model built by
# build_model.sh from the open-source Hermes base. Use 'hermes3:70b' to run the
# raw base instead. No cloud APIs / no Claude — everything runs locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=novel

# MLX alternative (run: mlx_lm.server --model mlx-community/Hermes-3-Llama-3.1-70B-4bit --port 8080)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=mlx
# LLM_MODEL=mlx-community/Hermes-3-Llama-3.1-70B-4bit

# --- Model routing (step 4: assign open-source models to roles) ---
# Leave blank to reuse LLM_MODEL. Point a role at a smaller open model to save
# compute — e.g. a small Hermes/Qwen for the grader.
# WORKER_MODEL=hermes3:8b
# GRADER_MODEL=hermes3:8b

# --- Generation ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# Graders run near-deterministic so verdicts are reproducible.
GRADER_TEMPERATURE=0.0

# --- Agent loop ---
AGENT_MAX_STEPS=12
# Allow the agent to run shell commands (0 = disabled, 1 = enabled). Off by default for safety.
AGENT_ENABLE_SHELL=0
# Directory the file/shell tools are sandboxed to.
AGENT_WORKSPACE=./workspace

# --- Self-improvement layer ---
# Max maker->verifier iterations in a goal loop before giving up.
GOAL_MAX_ITERATIONS=4
# Durable memory / state file (relative to the workspace).
AGENT_MEMORY_FILE=STATE.md
